---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  image?: string;
}

const {
  title = "0xSkunk - Portfolio",
  description = "",
  wide = false,
  image = "/og-image.png",
} = Astro.props;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/writeups", label: "Writeups" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/recursos", label: "Recursos" },
  { href: "/herramientas", label: "Herramientas" },
];

const currentPath = Astro.url.pathname;

// Header y footer SIEMPRE al mismo ancho (el más grande)
const containerClass = "max-w-5xl mx-auto px-6";


const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Canónica -->
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="0xSkunk - Portfolio" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#262932] text-[#dce0e6]">
    <header class="border-b border-[#3a3f4a]">
          <nav class:list={[containerClass, "py-4 flex items-center justify-between gap-4"]}>
          <a href="/" class="font-semibold text-lg text-white hover:text-[#9ab8ff] transition-colors shrink-0">
          ~/0xSkunk
        </a>

        <!-- Nav desktop -->
        <ul class="hidden md:flex gap-6 text-sm">
          {navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "transition-colors",
                    isActive
                      ? "text-[#9ab8ff] font-medium"
                      : "text-[#9aa1ae] hover:text-[#9ab8ff]",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>

        <!-- Botón hamburguesa (solo móvil) -->
        <button
          id="menu-toggle"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 rounded border border-[#3a3f4a] hover:border-[#9ab8ff] transition-colors"
        >
          <span class="menu-line block w-4 h-0.5 bg-[#dce0e6] transition-transform"></span>
          <span class="menu-line block w-4 h-0.5 bg-[#dce0e6] transition-transform"></span>
          <span class="menu-line block w-4 h-0.5 bg-[#dce0e6] transition-transform"></span>
        </button>
      </nav>

      <!-- Menú móvil desplegable -->
      <div
        id="mobile-menu"
        class="md:hidden hidden border-t border-[#3a3f4a] bg-[#262932]"
      >
        <ul class:list={[containerClass, "py-3 flex flex-col gap-1"]}>
            {navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "block py-2 px-2 rounded text-sm transition-colors",
                    isActive
                      ? "text-[#9ab8ff] font-medium bg-[#2e323c]"
                      : "text-[#9aa1ae] hover:text-[#9ab8ff] hover:bg-[#2e323c]",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </header>

    <main class:list={[containerClass, "flex-1 py-10 w-full"]}>
      <slot />
    </main>

        <footer class="border-t border-[#3a3f4a] mt-16">
        <div class:list={[containerClass, "py-4 flex flex-col items-center gap-3 sm:grid sm:grid-cols-3 sm:items-center sm:gap-4"]}>        <!-- Izquierda: 2026 + logo + nombre -->
        <div class="order-2 sm:order-1 flex items-center justify-center sm:justify-start gap-2 text-xs font-mono text-[#6b7280]">          <span>2026</span>
          <span class="text-[#9ab8ff]">©</span>
          <span class="text-[#9aa1ae]">0xSkunk</span>
        </div>

        <!-- Centro: iconos sociales -->
        <ul class="order-1 sm:order-2 flex items-center justify-center gap-3">
          <li>
            <a
              href="https://github.com/0xSkunk"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="flex items-center justify-center w-9 h-9 rounded border border-[#3a3f4a] text-[#9aa1ae] hover:border-[#9ab8ff] hover:text-[#9ab8ff] transition-colors"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.93c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.19.92-.26 1.91-.39 2.9-.39s1.98.13 2.9.39c2.21-1.5 3.18-1.19 3.18-1.19.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .3.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/tuusuario"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="flex items-center justify-center w-9 h-9 rounded border border-[#3a3f4a] text-[#9aa1ae] hover:border-[#9ab8ff] hover:text-[#9ab8ff] transition-colors"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="mailto:tu@email.com"
              aria-label="Email"
              class="flex items-center justify-center w-9 h-9 rounded border border-[#3a3f4a] text-[#9aa1ae] hover:border-[#9ab8ff] hover:text-[#9ab8ff] transition-colors"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 6-10 7L2 6" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://app.hackthebox.com/users/3121171"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="HackTheBox"
              class="group relative flex items-center justify-center w-9 h-9 rounded border border-[#3a3f4a] hover:border-[#9ab8ff] transition-colors"
            >
              <img
                src="https://cdn.simpleicons.org/hackthebox/9aa1ae"
                alt=""
                class="w-4 h-4 transition-opacity group-hover:opacity-0"
                loading="lazy"
              />
              <img
                src="https://cdn.simpleicons.org/hackthebox/9ab8ff"
                alt=""
                class="w-4 h-4 absolute transition-opacity opacity-0 group-hover:opacity-100"
                loading="lazy"
              />
            </a>
          </li>
        </ul>

        <!-- Derecha: Built with ♥ -->
        <p class="order-3 text-xs font-mono text-[#6b7280] text-center sm:text-right">
          Built with <span class="text-[#e88a8a]">♥</span>
        </p>
      </div>
    </footer>

    <script>
      function initMenu() {
        const toggle = document.getElementById("menu-toggle");
        const menu = document.getElementById("mobile-menu");
        if (!toggle || !menu) return;

        if (toggle.dataset.bound === "true") return;
        toggle.dataset.bound = "true";

        const closeMenu = () => {
          menu.classList.add("hidden");
          toggle.setAttribute("aria-expanded", "false");
          toggle.querySelectorAll(".menu-line").forEach((el) => {
            el.classList.remove("rotate-45", "opacity-0", "-rotate-45", "translate-y-2", "-translate-y-2");
          });
        };

        toggle.addEventListener("click", () => {
          const isOpen = !menu.classList.contains("hidden");
          const lines = toggle.querySelectorAll<HTMLElement>(".menu-line");

          if (isOpen) {
            closeMenu();
          } else {
            menu.classList.remove("hidden");
            toggle.setAttribute("aria-expanded", "true");
            if (lines[0]) lines[0].classList.add("translate-y-2", "rotate-45");
            if (lines[1]) lines[1].classList.add("opacity-0");
            if (lines[2]) lines[2].classList.add("-translate-y-2", "-rotate-45");
          }
        });

        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeMenu);
        });

        const mq = window.matchMedia("(min-width: 768px)");
        mq.addEventListener("change", (e) => {
          if (e.matches) closeMenu();
        });
      }

      initMenu();
      document.addEventListener("astro:page-load", initMenu);
    </script>
  </body>
</html>