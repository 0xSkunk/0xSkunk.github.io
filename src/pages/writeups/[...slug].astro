---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TocTree from "../../components/TocTree.astro";

export async function getStaticPaths() {
  const writeups = await getCollection("writeups");
  return writeups.map((writeup) => ({
    params: { slug: writeup.id },
    props: { writeup },
  }));
}

const { writeup } = Astro.props;
const { Content, headings } = await render(writeup);

const difficultyColor: Record<string, string> = {
  Easy: "bg-[#2d3b2d] text-[#8fd48f] border-[#3e5140]",
  Medium: "bg-[#3b3526] text-[#e5c07b] border-[#514a35]",
  Hard: "bg-[#3b2a2a] text-[#e88a8a] border-[#513a3a]",
  Insane: "bg-[#3a2540] text-[#c79ae5] border-[#503360]",
};

function formatDate(date: Date | undefined): string {
  if (!date) return "";
  return date.toLocaleDateString("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function formatDateShort(date: Date | undefined): string {
  if (!date) return "";
  return date.toLocaleDateString("es-ES", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function starFill(starIndex: number, rating: number): number {
  return Math.max(0, Math.min(100, (rating - starIndex) * 100));
}

const STAR_POINTS =
  "12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2";
const starIndexes = [0, 1, 2, 3, 4];

// --- Construir árbol de TOC ---
interface TocNode {
  slug: string;
  text: string;
  depth: number;
  rawDepth: number;
  children: TocNode[];
}

function buildTocTree(hs: typeof headings): TocNode[] {
  if (!hs.length) return [];

  // Profundidad base = el heading menos profundo presente
  const baseDepth = Math.min(...hs.map((h) => h.depth));

  // Convertimos a nodos con depth normalizada
  const nodes: TocNode[] = hs.map((h) => ({
    slug: h.slug,
    text: h.text,
    depth: h.depth - baseDepth + 1,
    rawDepth: h.depth,
    children: [],
  }));

  const root: TocNode = {
    slug: "",
    text: "",
    depth: 0,
    rawDepth: 0,
    children: [],
  };
  const stack: TocNode[] = [root];

  for (const node of nodes) {
    // Subimos en el stack hasta encontrar un padre con depth < node.depth
    while (stack.length > 1 && stack[stack.length - 1].depth >= node.depth) {
      stack.pop();
    }
    stack[stack.length - 1].children.push(node);
    stack.push(node);
  }

  return root.children;
}

const tocHeadings = headings.filter((h) => h.depth <= 3);
const tocTree = buildTocTree(tocHeadings);
const hasToc = tocHeadings.length >= 3;

const ogImage = writeup.data.image
  ? new URL(writeup.data.image.src, Astro.site).toString()
  : undefined;
---

<BaseLayout
  title={`${writeup.data.title} — Writeups`}
  description={`Writeup de ${writeup.data.title}`}
  image={ogImage}
  wide
>
  <div class:list={[hasToc && "lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10"]}>
    <!-- Sidebar TOC -->
    {hasToc && (
      <aside class="hidden lg:block">
        <nav class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto pr-1">
          <p class="font-mono text-sm text-white font-semibold mb-3 truncate">
            {writeup.data.title}
          </p>
          <TocTree items={tocTree} />
        </nav>
      </aside>
    )}

    <article class:list={[!hasToc && "max-w-6xl mx-auto"]}>
      <!-- Botón volver -->
      <a
        href="/writeups"
        class="inline-flex items-center gap-2 text-sm text-[#9aa1ae] hover:text-[#9ab8ff] transition-colors mb-8"
      >
        ← Volver a writeups
      </a>

      <!-- Cabecera del writeup -->
      <header class="mb-10">
        <div class="rounded-xl border border-[#3a3f4a] bg-[#2e323c] overflow-hidden">
          <!-- Fila superior: imagen + título + rating + badges -->
          <div class="flex items-start gap-4 sm:gap-5 p-4 sm:p-6">
            {writeup.data.image && (
              writeup.data.imageShape === "square" ? (
                <div class="w-16 h-16 sm:w-24 sm:h-24 rounded-lg overflow-hidden shrink-0">
                  <img
                    src={writeup.data.image.src}
                    alt={writeup.data.title}
                    class="w-full h-full object-cover"
                  />
                </div>
              ) : (
                <div class="w-16 h-16 sm:w-24 sm:h-24 shrink-0 flex items-center justify-center">
                  <img
                    src={writeup.data.image.src}
                    alt={writeup.data.title}
                    class="w-full h-full object-contain"
                  />
                </div>
              )
            )}

            <div class="flex-1 min-w-0">
              <!-- Título + rating: en móvil apilados, en desktop en fila -->
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-4 mb-3">
                <h1 class="text-xl sm:text-3xl font-bold text-white leading-tight">
                  {writeup.data.title}
                </h1>

                {writeup.data.rating !== undefined && (
                  <div class="flex items-center gap-2 shrink-0">
                    <div class="flex items-center gap-0.5">
                      {starIndexes.map((i) => {
                        const fill = starFill(i, writeup.data.rating!);
                        return (
                          <div class="relative w-4 h-4 shrink-0">
                            <svg
                              width="16"
                              height="16"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="#4a505e"
                              stroke-width="1.5"
                              stroke-linejoin="round"
                              stroke-linecap="round"
                              class="absolute inset-0"
                            >
                              <polygon points={STAR_POINTS} />
                            </svg>
                            <div
                              class="absolute inset-y-0 left-0 overflow-hidden"
                              style={`width: ${fill}%`}
                            >
                              <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="#e5c07b"
                                stroke="#e5c07b"
                                stroke-width="1.5"
                                stroke-linejoin="round"
                                stroke-linecap="round"
                              >
                                <polygon points={STAR_POINTS} />
                              </svg>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                    <span class="text-sm font-mono text-[#dce0e6]">
                      {writeup.data.rating.toFixed(1)}
                    </span>
                  </div>
                )}
              </div>

              <!-- Badges -->
              <div class="flex flex-wrap gap-1.5">
                {writeup.data.platform && (
                  <span class="text-xs font-mono px-2.5 py-1 rounded border border-[#3a3f4a] bg-[#2a2e38] text-[#9aa1ae]">
                    {writeup.data.platform}
                  </span>
                )}
                {writeup.data.difficulty && (
                  <span
                    class:list={[
                      "text-xs font-mono px-2.5 py-1 rounded border",
                      difficultyColor[writeup.data.difficulty],
                    ]}
                  >
                    {writeup.data.difficulty}
                  </span>
                )}
                {writeup.data.os && (
                  <span class="text-xs font-mono px-2.5 py-1 rounded border border-[#3a3f4a] bg-[#2a2e38] text-[#9aa1ae]">
                    {writeup.data.os}
                  </span>
                )}
              </div>
            </div>
          </div>

          <!-- Meta grid: Released / Completada / Rank -->
          {(writeup.data.releaseDate || writeup.data.date || writeup.data.userRank) && (
            <div class="grid grid-cols-1 sm:grid-cols-3 border-t border-[#3a3f4a] divide-y divide-[#3a3f4a] sm:divide-y-0 sm:divide-x">
              <div class="px-4 sm:px-5 py-3.5 sm:py-4 flex sm:block items-center justify-between gap-4">
                <p class="text-[10px] uppercase tracking-[0.15em] font-mono text-[#6b7280] sm:mb-1.5">
                  Released
                </p>
                <p class="text-sm font-mono text-[#dce0e6]">
                  {writeup.data.releaseDate
                    ? formatDateShort(writeup.data.releaseDate)
                    : "—"}
                </p>
              </div>

              <div class="px-4 sm:px-5 py-3.5 sm:py-4 flex sm:block items-center justify-between gap-4">
                <p class="text-[10px] uppercase tracking-[0.15em] font-mono text-[#6b7280] sm:mb-1.5">
                  Completada
                </p>
                <p class="text-sm font-mono text-[#9ab8ff]">
                  {writeup.data.date
                    ? formatDateShort(writeup.data.date)
                    : "—"}
                </p>
              </div>

              <div class="px-4 sm:px-5 py-3.5 sm:py-4 flex sm:block items-center justify-between gap-4">
                <p class="text-[10px] uppercase tracking-[0.15em] font-mono text-[#6b7280] sm:mb-1.5">
                  Mi rank
                </p>
                <p class="text-sm font-mono text-[#dce0e6]">
                  {writeup.data.userRank
                    ? `#${writeup.data.userRank}`
                    : "—"}
                </p>
              </div>
            </div>
          )}

          <!-- Tags -->
          {writeup.data.tags && writeup.data.tags.length > 0 && (
            <div class="px-4 sm:px-6 py-3.5 border-t border-[#3a3f4a] flex flex-wrap gap-x-2.5 gap-y-1">
              {writeup.data.tags.map((tag) => (
                <span class="text-xs font-mono text-[#9aa1ae]">#{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Contenido -->
      <div class="prose-custom">
        <Content />
      </div>
    </article>
  </div>

      <!-- Botón volver arriba -->
    <button
      id="back-to-top"
      type="button"
      aria-label="Volver arriba"
      class="back-to-top"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-5 h-5"
      >
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>

 <script>
  // ---------- Botón volver arriba ----------
function initBackToTop() {
  const btn = document.getElementById("back-to-top");
  if (!btn) return;

  if (btn.dataset.bound === "true") return;
  btn.dataset.bound = "true";

  const SHOW_AFTER = 400; // px de scroll a partir de los cuales aparece

  const update = () => {
    if (window.scrollY > SHOW_AFTER) {
      btn.classList.add("back-to-top--visible");
    } else {
      btn.classList.remove("back-to-top--visible");
    }
  };

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  };

  btn.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  window.addEventListener("scroll", onScroll, { passive: true });
  update();
}
    // ---------- Code blocks expand/collapse ----------
function initCodeBlocks() {
  const COLLAPSE_HEIGHT = 400;

  document
    .querySelectorAll<HTMLPreElement>(".prose-custom pre")
    .forEach((pre) => {
      if (pre.dataset.processed === "true") return;
      pre.dataset.processed = "true";

      const lang = pre.dataset.language || "";

      // Envolver el pre en un wrapper
      const wrapper = document.createElement("div");
      wrapper.className = "code-block";
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const header = document.createElement("div");
      header.className = "code-header";

      const langLabel = document.createElement("span");
      langLabel.className = "code-lang";
      langLabel.textContent = lang;
      header.appendChild(langLabel);

      // Contenedor de acciones (copiar + expand) a la derecha
      const actions = document.createElement("div");
      actions.className = "code-actions";

      // --- Botón copiar ---
      const copyBtn = document.createElement("button");
      copyBtn.type = "button";
      copyBtn.className = "code-action-btn code-copy-btn";
      copyBtn.setAttribute("aria-label", "Copiar código");
      copyBtn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="code-action-icon">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span class="code-action-text">COPY</span>
      `;

      copyBtn.addEventListener("click", async () => {
        const codeEl = pre.querySelector("code");
        const text = codeEl?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.classList.add("code-action-btn--success");
          const textSpan = copyBtn.querySelector(".code-action-text");
          if (textSpan) textSpan.textContent = "COPIED";
          setTimeout(() => {
            copyBtn.classList.remove("code-action-btn--success");
            if (textSpan) textSpan.textContent = "COPY";
          }, 1500);
        } catch {
          // Fallback por si el navegador bloquea clipboard API
          const range = document.createRange();
          if (codeEl) {
            range.selectNode(codeEl);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
            document.execCommand("copy");
            sel?.removeAllRanges();
            const textSpan = copyBtn.querySelector(".code-action-text");
            if (textSpan) textSpan.textContent = "COPIED";
            setTimeout(() => {
              if (textSpan) textSpan.textContent = "COPY";
            }, 1500);
          }
        }
      });

      actions.appendChild(copyBtn);

      // --- Botón Expand (si es necesario) ---
      const fullHeight = pre.scrollHeight;
      if (fullHeight > COLLAPSE_HEIGHT) {
        pre.classList.add("is-collapsible", "is-collapsed");
        wrapper.classList.add("has-collapsed");

        const expandBtn = document.createElement("button");
        expandBtn.type = "button";
        expandBtn.className = "code-action-btn code-expand-btn";
        expandBtn.textContent = "Expand";
        expandBtn.addEventListener("click", () => {
          const isCollapsed = pre.classList.toggle("is-collapsed");
          wrapper.classList.toggle("has-collapsed", isCollapsed);
          expandBtn.textContent = isCollapsed ? "Expand" : "Collapse";
        });

        actions.appendChild(expandBtn);
      }

      header.appendChild(actions);
      wrapper.appendChild(header);
    });
}

    // ---------- TOC scroll-spy + colapso ----------
    function initToc() {
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]")
      );
      if (!links.length) return;

      // Mapea slug → { el, link }
      const items: { slug: string; el: HTMLElement; link: HTMLAnchorElement }[] = [];
      for (const link of links) {
        const slug = link.getAttribute("data-toc-link");
        if (!slug) continue;
        const el = document.getElementById(slug);
        if (el) items.push({ slug, el, link });
      }
      if (!items.length) return;

      // -------- Colapso: expandir solo la rama activa --------
      const lis = Array.from(
        document.querySelectorAll<HTMLLIElement>("li[data-has-children='true']")
      );

      const updateExpansion = (activeSlug: string | null) => {
        lis.forEach((li) => {
          // ¿Este li contiene el activeSlug en sí mismo o en sus descendientes?
          const subtreeLinks = li.querySelectorAll("a[data-toc-link]");
          const contains = Array.from(subtreeLinks).some(
            (a) => a.getAttribute("data-toc-link") === activeSlug
          );
          li.setAttribute("data-expanded", contains ? "true" : "false");
        });
      };

      // -------- Activo según scroll --------
      const OFFSET = 120; // px desde el top de la ventana

      const findActiveSlug = (): string => {
        let active = items[0].slug;
        for (const item of items) {
          const top = item.el.getBoundingClientRect().top;
          if (top - OFFSET <= 0) {
            active = item.slug;
          } else {
            break;
          }
        }
        return active;
      };

      const setActive = (slug: string) => {
        for (const item of items) {
          item.link.classList.toggle("toc-active", item.slug === slug);
        }
        updateExpansion(slug);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          setActive(findActiveSlug());
          ticking = false;
        });
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });

      // Estado inicial
      setActive(findActiveSlug());
    }

    initCodeBlocks();
    initToc();
    document.addEventListener("astro:page-load", () => {
      initCodeBlocks();
      initToc();
    });
    // DEBUG — borrar cuando hayamos arreglado el árbol
const debugHeadings = document.querySelectorAll("[data-toc-link]");
console.log("=== DEBUG TOC ===");
debugHeadings.forEach((a) => {
  console.log(
    a.getAttribute("data-toc-depth"),
    "→",
    a.textContent?.trim(),
    "| id:",
    a.getAttribute("data-toc-link")
  );
});
  initCodeBlocks();
  initToc();
  initBackToTop();  // ← añadir esta línea

  document.addEventListener("astro:page-load", () => {
    initCodeBlocks();
    initToc();
    initBackToTop();  // ← añadir también aquí
  });
  </script>


</BaseLayout>