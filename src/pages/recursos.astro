---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resources } from "../data/resources";
---

<BaseLayout
  title="Recursos | 0xSkunk"
  description="Recursos útiles de ciberseguridad"
  wide
>
  <div class="max-w-5xl mx-auto lg:grid lg:grid-cols-[minmax(0,1fr)_180px] lg:gap-12">
    <!-- Contenido principal -->
    <article>
      <p class="font-mono text-sm text-[#9ab8ff] mb-3">$ cat recursos.md</p>
      <div class="callout mb-10" data-callout="note">
        <div class="callout-title">Recursos</div>
        <div class="callout-content">
          <p>
            Lista de recursos que he ido recopilando y que pueden ser utiles. Tambien incluyo algunos cheatsheet creados por mi.
          </p>
        </div>
      </div>

      <div class="space-y-10">
        {resources.map((cat) => (
          <section id={cat.id} class="scroll-mt-24">
            <h2 class="flex items-center gap-3 text-xl font-bold text-white mb-5 pb-2 border-b border-[#3a3f4a]">
              <span class="font-mono text-[#6b7280]">//</span>
              {cat.name}
            </h2>

            <ul class="grid gap-x-8 gap-y-1.5 sm:grid-cols-2">
              {cat.items.map((item) => (
                <li class="text-sm leading-relaxed flex gap-2">
                  <span class="text-[#9aa1ae] shrink-0 select-none">&gt;</span>
                  <span>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-[#dce0e6] hover:text-[#9ab8ff] transition-colors"
                    >
                      {item.name}
                    </a>
                    {item.description && (
                      <span class="text-[#9aa1ae]">
                        {" — "}
                        {item.description}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </article>

    <!-- Rail lateral derecho -->
    <aside class="hidden lg:block">
      <nav class="sticky top-8">
        <p class="font-mono text-xs uppercase tracking-wider text-[#9ab8ff] mb-4">
          Categorías
        </p>
        <ul class="border-l border-[#3a3f4a]">
          {resources.map((cat) => (
            <li>
              <a
                href={`#${cat.id}`}
                data-rail-link={cat.id}
                class="rail-link flex items-center gap-3 py-1.5 pl-4 pr-2 text-sm text-[#9aa1ae] hover:text-[#dce0e6] transition-colors -ml-px border-l-2 border-transparent"
              >
                <span class="rail-dot w-1.5 h-1.5 rounded-full bg-[#3a3f4a] shrink-0 transition-colors"></span>
                <span>{cat.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>

  <script>
    function initRail() {
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-rail-link]")
      );
      if (!links.length) return;

      const items = links
        .map((link) => {
          const id = link.getAttribute("data-rail-link");
          const el = id ? document.getElementById(id) : null;
          return el && id ? { el, id, link } : null;
        })
        .filter((x): x is { el: HTMLElement; id: string; link: HTMLAnchorElement } => x !== null);

      if (!items.length) return;

      const update = () => {
        const OFFSET = 140;
        let activeId = items[0].id;
        for (const item of items) {
          const top = item.el.getBoundingClientRect().top;
          if (top - OFFSET <= 0) activeId = item.id;
          else break;
        }

        for (const item of items) {
          const isActive = item.id === activeId;
          item.link.classList.toggle("rail-active", isActive);
          const dot = item.link.querySelector(".rail-dot") as HTMLElement | null;
          if (dot) {
            dot.classList.toggle("bg-[#9ab8ff]", isActive);
            dot.classList.toggle("bg-[#3a3f4a]", !isActive);
          }
        }
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }

    initRail();
    document.addEventListener("astro:page-load", initRail);
  </script>
</BaseLayout>